    <string name="wordblock_enabled_summary" translatable="false">Delete words on your list as soon as you finish typing them. Password and number fields are never touched.</string>
    <string name="wordblock_idle" translatable="false">Remove after a pause</string>
    <string name="wordblock_idle_summary" translatable="false">Also remove a blocked word if you stop typing for a moment, so it is gone before you tap an app\'s Send button. It can also cut short a word you type slowly, so it is off by default.</string>
