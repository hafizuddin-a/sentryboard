    <string name="guard_channel_name" translatable="false">Uninstall protection guard</string>
    <string name="guard_notification_title" translatable="false">Uninstall protection active</string>
    <string name="guard_notification_text" translatable="false">Covering the device admin screen while your settings lock is on.</string>
    <string name="guard_notification_degraded_title" translatable="false">Uninstall protection is degraded</string>
